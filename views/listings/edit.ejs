<% layout("/layouts/boilerplate") %>
<body>
    <main>
        <div class="row mt-3 mb-3">
            <div class="col-8 offset-2">
                <h3>Edit your listing</h3>
                <form action="/listings/<%= listing._id %>?_method=PUT" method="POST" class="needs-validation" novalidate >
                    <div class="mb-3">
                        <label for="title" class="form-label">Title</label>
                        <input type="text" id="title" class="form-control" name="listing[title]" 
                               value="<%= listing.title || '' %>" placeholder="Enter the title" required>
                               <div class="invalid-feedback">Title does not look good</div>
                               <div class="valid-feedback">Title looks good</div>
                    </div>

                    <div class="mb-3">
                        <label for="description" class="form-label">Description</label>
                        <textarea id="description" class="form-control" name="listing[description]" 
                                  placeholder="Enter a description" required><%= listing.description || '' %></textarea>
                                  <div class="invalid-feedback">Description does not look good</div>
                                  <div class="valid-feedback">Description looks good</div>
                    </div>

                    <div class="mb-3">
                        <label for="image" class="form-label">Image Link</label>
                        <input type="text" id="image" class="form-control" name="listing[image]" 
                               value="<%= listing.image || '' %>" placeholder="Enter an image URL">
                               <div class="invalid-feedback">Image does not look good</div>
                               <div class="valid-feedback">Image looks good</div>
                    </div>

                    <div class="row">
                        <div class="mb-3 col-md-4">
                            <label for="price" class="form-label">Price</label>
                            <input type="number" id="price" class="form-control" name="listing[price]" 
                                   value="<%= listing.price || '' %>" placeholder="Enter the price" required>
                                   <div class="invalid-feedback">Price does not look good</div>
                                   <div class="valid-feedback">Price looks good</div>
                        </div>
                        <div class="mb-3 col-md-8">
                            <label for="country" class="form-label">Country</label>
                            <input type="text" id="country" class="form-control" name="listing[country]" 
                                   value="<%= listing.country || '' %>" placeholder="Enter the country" required>
                                   <div class="invalid-feedback">Country does not look good</div>
                                   <div class="valid-feedback">Country looks good</div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="location" class="form-label">Location</label>
                        <input type="text" id="location" class="form-control" name="listing[location]" 
                               value="<%= listing.location || '' %>" placeholder="Enter the location">
                               <div class="invalid-feedback">Location does not look good</div>
                               <div class="valid-feedback">Location looks good</div>
                    </div>

                    <button class="btn btn-dark">Save Changes</button>
                </form>
            </div>
        </div>
    </main>
</body>
