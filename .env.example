# Copy this file to `.env` and fill in your values (never commit `.env`).

# MongoDB Atlas (or local) connection string — include database name, e.g. .../wanderlust
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.example.mongodb.net/wanderlust?retryWrites=true&w=majority

# Optional: server port (defaults to 9090 in App.js if unset)
# PORT=9090
